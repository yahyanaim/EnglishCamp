# Microsoft Azure Speech (server only). Choose the Free F0 tier in Azure.
# Next.js uses .env.local; the Cloudflare preview uses .dev.vars.
# Never put the key in NEXT_PUBLIC_* variables or source code.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Legacy offline recording-generation helper; not needed for live Azure speech.
ENGLISHCAMP_TTS_PYTHON=python3
# Optional: writable private folder for cached MP3s. Defaults to .camp-cache/voices.
# ENGLISHCAMP_VOICE_CACHE=/absolute/path/to/voice-cache

# Optional automatic placement speaking assessment (separate from Microsoft narration).
# Set these on the SERVER only. Never use NEXT_PUBLIC_ for a secret.
# Obtain a separately billed API key from the OpenAI API dashboard.
# OPENAI_API_KEY=
# Enable only after approving this provider and updating the site's privacy notice.
# ENGLISHCAMP_SPEAKING_ENABLED=true
# Audio-capable Chat Completions model. Text-only models cannot assess spoken delivery.
# ENGLISHCAMP_SPEAKING_MODEL=gpt-audio-1.5
# Per-process hourly request ceiling; default 30, two concurrent assessments.
# ENGLISHCAMP_SPEAKING_HOURLY_LIMIT=30
