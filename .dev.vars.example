# Optional Microsoft Speech resource: select the Free F0 tier in Azure.
# Add real values only to .dev.vars locally or Cloudflare's secret settings.
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
# OpenAI assessment has separate API costs and stays disabled unless configured.
ENGLISHCAMP_SPEAKING_ENABLED="false"
OPENAI_API_KEY=""
# Google AI Studio key from a Free project. Never use a NEXT_PUBLIC_ variable.
GEMINI_API_KEY=""
# Optional private CPU service. Leave empty until that service is deployed.
OPENPRONOUNCE_URL=""
OPENPRONOUNCE_TOKEN=""
OPENPRONOUNCE_MODAL_KEY=""
OPENPRONOUNCE_MODAL_SECRET=""
# Owner-only invitation management. Generate locally; never paste the real key here.
# node scripts/prepare-invitation-owner.cjs writes only its hash into .dev.vars.
INVITATION_ADMIN_HASH=""
# Invitation emails: Brevo is selected for the current setup.
# Use an API v3 key (not an SMTP password) and a verified sender address.
# Keep real values in .dev.vars locally and in Cloudflare Worker secrets.
INVITATION_EMAIL_PROVIDER="brevo"
BREVO_API_KEY=""
INVITATION_EMAIL_FROM=""
# Optional alternative: set INVITATION_EMAIL_PROVIDER="resend" with a verified domain.
RESEND_API_KEY=""
