{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "englishcamp",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "LEARNERS_DB",
      "database_name": "englishcamp-learners",
      "database_id": "850283ff-e819-4c4f-8ed2-86360dcdb37d",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": ".cloudflare-build/app/out",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/reading", "/reading/", "/en", "/en/*", "/ar", "/ar/*"]
  },
  "vars": {
    "ENGLISHCAMP_SPEAKING_ENABLED": "false",
    "ENGLISHCAMP_SPEAKING_HOURLY_LIMIT": "10"
  },
  "observability": { "enabled": false }
}
